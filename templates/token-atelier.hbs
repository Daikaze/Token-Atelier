<div class="tka-root">
  <div class="tka-left">
    <div class="tka-canvas-wrap">
      <canvas class="tka-canvas"></canvas>
    </div>
    <p class="tka-hint">Drag to move. Scroll to zoom.</p>

    <div class="tka-field">
      <label>Zoom</label>
      <input type="range" name="scale" min="0.05" max="6" step="0.001">
    </div>
    <div class="tka-field">
      <label>Rotation</label>
      <input type="range" name="rot" min="-180" max="180" step="0.5">
    </div>
    <div class="tka-field tka-check">
      <label><input type="checkbox" name="linked"> Use the shared alignment for this art</label>
    </div>
    <div class="tka-row">
      <button type="button" data-action="set-shared"><i class="fas fa-link"></i> Save as shared alignment</button>
      <button type="button" data-action="reset"><i class="fas fa-expand"></i> Fit</button>
    </div>
  </div>

  <div class="tka-right">
    <section>
      <h3>Art</h3>
      <ul class="tka-arts">
        {{#each arts}}
        <li class="tka-art{{#if active}} active{{/if}}" data-action="select-art" data-id="{{id}}">
          <img src="{{thumb}}" alt="">
          <input class="tka-label" type="text" value="{{label}}">
          <button type="button" data-action="remove-art" title="Remove"><i class="fas fa-trash"></i></button>
        </li>
        {{else}}
        <li class="tka-empty">No art yet. Add an image to get started.</li>
        {{/each}}
      </ul>
      <div class="tka-row">
        <button type="button" data-action="add-art"><i class="fas fa-plus"></i> Add art</button>
        <button type="button" data-action="add-portrait"><i class="fas fa-user"></i> Use portrait</button>
      </div>
      <div class="tka-bulk-import">
        <h4>Bulk Import</h4>
        <p class="tka-description">Add several art variants at once. Existing images and alignment stay unchanged. Up to 250 images per actor.</p>
        <div class="tka-row">
          <button type="button" data-action="bulk-folder" title="Add all supported images in a Foundry Data folder (not subfolders)"><i class="fas fa-folder-open"></i> Import Foundry folder</button>
          <button type="button" data-action="bulk-upload" title="Choose multiple images on your computer, upload, and import"><i class="fas fa-images"></i> Upload multiple images</button>
          <input type="file" name="bulkArtFiles" accept=".png,.jpg,.jpeg,.webp,.gif,.avif,image/png,image/jpeg,image/webp,image/gif,image/avif" multiple class="tka-hidden-file" tabindex="-1">
        </div>
      </div>
    </section>

    <section>
      <h3>Style</h3>
      <div class="tka-field">
        <label>Shape</label>
        <select data-bind="style.mask">
          <option value="circle">Circle</option>
          <option value="rounded">Rounded square</option>
          <option value="square">Square</option>
        </select>
      </div>
      <div class="tka-field">
        <label>Frame</label>
        <select data-bind="style.frame">
          <option value="ring">Ring</option>
          <option value="custom">Custom image</option>
          <option value="none">None</option>
        </select>
      </div>
      <div class="tka-field">
        <label>Ring color</label>
        <input type="color" data-bind="style.ringColor">
      </div>
      <div class="tka-field">
        <label>Ring width</label>
        <input type="range" min="0" max="10" step="0.25" data-bind="style.ringWidth" data-type="number">
      </div>
      <div class="tka-field">
        <label>Frame image</label>
        <input type="text" data-bind="style.customFrame" placeholder="PNG with a transparent middle">
        <button type="button" data-action="pick-frame" title="Browse"><i class="fas fa-file-import"></i></button>
      </div>
      <div class="tka-field tka-check">
        <label><input type="checkbox" data-bind="style.bgTransparent"> Transparent background</label>
      </div>
      <div class="tka-field">
        <label>Background</label>
        <input type="color" data-bind="style.bgColor">
      </div>
    </section>

    <section class="tka-presets">
      <h3>Border Presets Library <small>(world / GM)</small></h3>
      <p class="tka-description">Presets save the frame, shape, colors and background. Art, alignment and export options stay untouched.</p>
      <div class="tka-field">
        <label>Preset</label>
        <select name="borderPreset">
          <option value="">Choose a saved preset</option>
          {{#each presets}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </div>
      <div class="tka-row">
        <button type="button" data-action="preset-apply"><i class="fas fa-paint-brush"></i> Apply</button>
        <button type="button" data-action="preset-delete" class="tka-danger"><i class="fas fa-trash"></i> Delete</button>
      </div>
      <div class="tka-field">
        <label>New name</label>
        <input name="presetName" type="text" maxlength="70" placeholder="e.g. Celestial Gold">
      </div>
      <div class="tka-row">
        <button type="button" data-action="preset-save"><i class="fas fa-bookmark"></i> Save current border as new preset</button>
      </div>
    </section>

    <section class="tka-backup">
      <h3>Safe Save &amp; Backup</h3>
      <p class="tka-description">Exports use unique filenames instead of overwriting existing PNGs. Backups save this actor's Token Atelier settings as JSON.</p>
      <div class="tka-row">
        <button type="button" data-action="backup-download"><i class="fas fa-download"></i> Download backup</button>
        <button type="button" data-action="backup-restore"><i class="fas fa-file-import"></i> Restore backup</button>
        <input name="restoreBackupFile" type="file" accept=".json,application/json" class="tka-hidden-file" tabindex="-1">
      </div>
    </section>

    <section>
      <h3>Export</h3>
      <div class="tka-field">
        <label>Size</label>
        <select data-bind="style.size" data-type="number">
          <option value="256">256 px</option>
          <option value="512">512 px</option>
          <option value="1024">1024 px</option>
        </select>
      </div>
      <div class="tka-field">
        <label>Folder</label>
        <input type="text" data-bind="style.folder">
      </div>
      <div class="tka-field tka-check">
        <label><input type="checkbox" data-bind="style.applyToken"> Set as the actor's token image</label>
      </div>
      <div class="tka-field tka-check">
        <label><input type="checkbox" data-bind="style.applyPortrait"> Also set as the actor's portrait</label>
      </div>
      <div class="tka-row">
        <button type="button" class="tka-primary" data-action="export"><i class="fas fa-save"></i> Save selected token</button>
        <button type="button" data-action="export-all"><i class="fas fa-layer-group"></i> Export all arts</button>
      </div>
      <p class="tka-description">Batch export creates PNGs only; it does not change the actor portrait or token image.</p>
    </section>
  </div>
</div>
