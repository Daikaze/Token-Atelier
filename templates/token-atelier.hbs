<div class="tka-root">
  <div class="tka-left">
    <div class="tka-canvas-wrap">
      <canvas class="tka-canvas"></canvas>
    </div>
    <p class="tka-hint">Drag to move. Scroll to zoom.</p>

    <div class="tka-field">
      <label>Zoom</label>
      <input type="range" name="scale" min="0.05" max="6" step="0.001">
    </div>
    <div class="tka-field">
      <label>Rotation</label>
      <input type="range" name="rot" min="-180" max="180" step="0.5">
    </div>
    <div class="tka-field tka-check">
      <label><input type="checkbox" name="linked"> Use the shared alignment for this art</label>
    </div>
    <div class="tka-row">
      <button type="button" data-action="set-shared"><i class="fas fa-link"></i> Save as shared alignment</button>
      <button type="button" data-action="reset"><i class="fas fa-expand"></i> Fit</button>
    </div>
  </div>

  <div class="tka-right">
    <section>
      <h3>Art</h3>
      <ul class="tka-arts">
        {{#each arts}}
        <li class="tka-art{{#if active}} active{{/if}}" data-action="select-art" data-id="{{id}}">
          <img src="{{thumb}}" alt="">
          <input class="tka-label" type="text" value="{{label}}">
          <button type="button" data-action="remove-art" title="Remove"><i class="fas fa-trash"></i></button>
        </li>
        {{else}}
        <li class="tka-empty">No art yet. Add an image to get started.</li>
        {{/each}}
      </ul>
      <div class="tka-row">
        <button type="button" data-action="add-art"><i class="fas fa-plus"></i> Add art</button>
        <button type="button" data-action="add-portrait"><i class="fas fa-user"></i> Use portrait</button>
      </div>
    </section>

    <section>
      <h3>Style</h3>
      <div class="tka-field">
        <label>Shape</label>
        <select data-bind="style.mask">
          <option value="circle">Circle</option>
          <option value="rounded">Rounded square</option>
          <option value="square">Square</option>
        </select>
      </div>
      <div class="tka-field">
        <label>Frame</label>
        <select data-bind="style.frame">
          <option value="ring">Ring</option>
          <option value="custom">Custom image</option>
          <option value="none">None</option>
        </select>
      </div>
      <div class="tka-field">
        <label>Ring color</label>
        <input type="color" data-bind="style.ringColor">
      </div>
      <div class="tka-field">
        <label>Ring width</label>
        <input type="range" min="0" max="10" step="0.25" data-bind="style.ringWidth" data-type="number">
      </div>
      <div class="tka-field">
        <label>Frame image</label>
        <input type="text" data-bind="style.customFrame" placeholder="PNG with a transparent middle">
        <button type="button" data-action="pick-frame" title="Browse"><i class="fas fa-file-import"></i></button>
      </div>
      <div class="tka-field tka-check">
        <label><input type="checkbox" data-bind="style.bgTransparent"> Transparent background</label>
      </div>
      <div class="tka-field">
        <label>Background</label>
        <input type="color" data-bind="style.bgColor">
      </div>
    </section>

    <section>
      <h3>Export</h3>
      <div class="tka-field">
        <label>Size</label>
        <select data-bind="style.size" data-type="number">
          <option value="256">256 px</option>
          <option value="512">512 px</option>
          <option value="1024">1024 px</option>
        </select>
      </div>
      <div class="tka-field">
        <label>Folder</label>
        <input type="text" data-bind="style.folder">
      </div>
      <div class="tka-field tka-check">
        <label><input type="checkbox" data-bind="style.applyToken"> Set as the actor's token image</label>
      </div>
      <div class="tka-field tka-check">
        <label><input type="checkbox" data-bind="style.applyPortrait"> Also set as the actor's portrait</label>
      </div>
      <div class="tka-row">
        <button type="button" class="tka-primary" data-action="export"><i class="fas fa-save"></i> Save token</button>
      </div>
    </section>
  </div>
</div>
